<?xml version="1.0" encoding="utf-8"?>
<!-- Member 2 Stitch slot label: white when selected, ink otherwise, gray when booked. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/node_booked_fg" />
    <item android:state_selected="true" android:color="@android:color/white" />
    <item android:color="@color/node_ink" />
</selector>
