<?xml version="1.0" encoding="utf-8"?>
<!-- Member 2 Stitch date pill: green when selected, white otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/node_green" />
            <stroke android:width="1dp" android:color="@color/node_green" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@android:color/white" />
            <stroke android:width="1dp" android:color="@color/node_line" />
        </shape>
    </item>
</selector>
