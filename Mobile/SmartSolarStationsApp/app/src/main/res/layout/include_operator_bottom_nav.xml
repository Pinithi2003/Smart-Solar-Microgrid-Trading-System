<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/operatorBottomNav"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/solar_card"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Operator Home -->
    <LinearLayout
        android:id="@+id/opNavHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/opIconHome"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nav_home"
            app:tint="@color/solar_muted" />

        <TextView
            android:id="@+id/opTextHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tab_home"
            android:textColor="@color/solar_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Operator Scan QR -->
    <LinearLayout
        android:id="@+id/opNavScan"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/opIconScan"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_scan"
            app:tint="@color/solar_muted" />

        <TextView
            android:id="@+id/opTextScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tab_scan"
            android:textColor="@color/solar_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Operator Completed Transfers -->
    <LinearLayout
        android:id="@+id/opNavTransfers"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/opIconTransfers"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_history"
            app:tint="@color/solar_muted" />

        <TextView
            android:id="@+id/opTextTransfers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tab_transactions"
            android:textColor="@color/solar_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Operator Profile -->
    <LinearLayout
        android:id="@+id/opNavProfile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/opIconProfile"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nav_user"
            app:tint="@color/solar_muted" />

        <TextView
            android:id="@+id/opTextProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tab_profile"
            android:textColor="@color/solar_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
