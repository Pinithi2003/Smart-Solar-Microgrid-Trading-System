<?xml version="1.0" encoding="utf-8"?>
<!-- Member 2 Stitch stations list: header + search + chips + map strip + cards + bottom nav. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/node_bg"
    android:orientation="vertical">

    <include layout="@layout/include_app_header" />

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_node_search"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:hint="@string/search_zones_hint"
        android:inputType="text"
        android:padding="13dp"
        android:textColor="@color/node_ink"
        android:textColorHint="@color/solar_muted"
        android:textSize="14sp" />

    <include layout="@layout/include_filter_chips" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/stations_title"
            android:textColor="@color/node_ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/statusFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/mapStrip"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/statTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="6dp"
            android:background="@drawable/bg_node_card"
            android:gravity="center"
            android:padding="12dp"
            android:text="Total: –"
            android:textColor="@color/node_ink"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statActive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="6dp"
            android:background="@drawable/bg_node_card"
            android:gravity="center"
            android:padding="12dp"
            android:text="Active: –"
            android:textColor="@color/node_ink"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statAvailable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_node_card"
            android:gravity="center"
            android:padding="12dp"
            android:text="kWh: –"
            android:textColor="@color/node_ink"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/stationsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/lastRefreshed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="@color/solar_muted"
        android:textSize="11sp" />

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>