<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_node_card"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/mapBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_node_chip_sel"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="@string/map_preview_badge"
        android:textColor="@color/node_green_dark"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Mock map: drawn grid + dots in MapPreviewFragment (no API key needed). -->
    <FrameLayout
        android:id="@+id/mockMapCanvas"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="8dp"
        android:background="@color/node_bg" />

    <TextView
        android:id="@+id/mapCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/map_offline_note"
        android:textColor="@color/solar_muted"
        android:textSize="11sp" />
</LinearLayout>
