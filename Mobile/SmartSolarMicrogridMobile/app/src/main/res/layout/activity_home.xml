<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8F5">

    <include layout="@layout/include_app_header" />

    <!-- Main content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Welcome -->
            <TextView
                android:id="@+id/homeUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome"
                android:textColor="#0E3B22"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeUserRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Prosumer"
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <!-- Introduction card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#E7F3EA">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Solar Microgrid"
                    android:textColor="#0E3B22"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Manage your solar energy reservations, discover nearby grid stations and access your transaction services."
                    android:textColor="#374151"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

            <!-- Dashboard title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Quick Access"
                android:textColor="#111827"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Stations -->
            <TextView
                android:id="@+id/btnHomeStations"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="#FFFFFF"
                android:text="Solar Stations   ›"
                android:textColor="#0E3B22"
                android:textSize="16sp"
                android:textStyle="bold"
                android:elevation="2dp" />

            <!-- QR -->
            <TextView
                android:id="@+id/btnHomeQr"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="#FFFFFF"
                android:text="Transaction QR / Operator   ›"
                android:textColor="#0E3B22"
                android:textSize="16sp"
                android:textStyle="bold"
                android:elevation="2dp" />

            <!-- Profile -->
            <TextView
                android:id="@+id/btnHomeProfile"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="#FFFFFF"
                android:text="My Profile   ›"
                android:textColor="#0E3B22"
                android:textSize="16sp"
                android:textStyle="bold"
                android:elevation="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Use the navigation bar below to access each module."
                android:textColor="#6B7280"
                android:textSize="13sp" />

        </LinearLayout>

    </ScrollView>

    <include layout="@layout/include_bottom_nav" />

</LinearLayout>